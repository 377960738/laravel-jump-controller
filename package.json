{
  "name": "laravel-jump-controller",
  "displayName": "Laravel Jump Controller",
  "description": "Navigate from Laravel routes to controller classes and methods.",
  "version": "0.2.3",
  "publisher": "pgl",
  "author": {
    "name": "pgl"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/377960738/laravel-jump-controller.git"
  },
  "bugs": {
    "url": "https://github.com/377960738/laravel-jump-controller/issues"
  },
  "homepage": "https://github.com/377960738/laravel-jump-controller#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "laravel",
    "php",
    "route",
    "goto",
    "jump",
    "controller"
  ],
  "galleryBanner": {
    "color": "#FF544A",
    "theme": "light"
  },
  "activationEvents": [
    "onLanguage:php"
  ],
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check": "npm run typecheck && npm test && npm run package:check",
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:extension": "npm run compile && node scripts/integration.mjs",
    "package:check": "npm run compile && vsce ls --no-dependencies",
    "package": "npm run check && vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "php-parser": "3.7.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "contributes": {
    "configuration": {
      "title": "Laravel Jump Controller",
      "properties": {
        "laravel_jump_controller.pathController": {
          "type": "string",
          "default": "app/Http/Controllers",
          "description": "Fallback controller directory relative to the Laravel project root. Composer PSR-4 mappings take precedence."
        },
        "laravel_jump_controller.pathNamespace": {
          "type": "string",
          "default": "App\\Http\\Controllers",
          "description": "Fallback namespace corresponding to pathController. Composer PSR-4 mappings take precedence."
        }
      }
    },
    "commands": [
      {
        "command": "laravelJumpController.refreshIndex",
        "title": "Laravel: Refresh Controller Index"
      }
    ]
  },
  "qna": "marketplace"
}
